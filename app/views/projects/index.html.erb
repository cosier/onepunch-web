<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Projects</h1>
        <p class="text-gray-600 mt-1">Manage your projects and track time</p>
      </div>
      <div class="flex items-center space-x-4">
        <%= link_to "New Project", new_project_path,
            class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>
  </div>

  <!-- Active Projects -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Active Projects</h2>
    <% if @projects.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @projects.each do |project| %>
          <div class="bg-white rounded-lg shadow hover:shadow-md transition-shadow duration-200">
            <div class="p-6">
              <div class="flex items-center space-x-3 mb-4">
                <span class="inline-block w-4 h-4 rounded-full"
                      style="background-color: <%= project.color || '#6B7280' %>"></span>
                <h3 class="text-lg font-semibold text-gray-900 truncate">
                  <%= link_to project.name, project_path(project), class: "hover:text-indigo-600" %>
                </h3>
              </div>

              <% if project.description.present? %>
                <p class="text-sm text-gray-600 mb-4 line-clamp-3">
                  <%= truncate(project.description, length: 120) %>
                </p>
              <% end %>

              <div class="space-y-2 text-sm text-gray-500">
                <% if project.hourly_rate.present? %>
                  <p><strong>Rate:</strong> $<%= project.hourly_rate %>/hour</p>
                <% end %>
                <% if project.client.present? %>
                  <p><strong>Client:</strong> <%= project.client.name %></p>
                <% end %>
              </div>

              <div class="mt-6 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                  <!-- Quick Timer Button -->
                  <%= render "shared/timer_button",
                      project: project,
                      icon_only: true,
                      size: "small" %>

                  <%= link_to "Edit", edit_project_path(project),
                      class: "text-indigo-600 hover:text-indigo-500 text-sm font-medium" %>
                  <%= link_to "Archive", archive_project_path(project),
                      data: { turbo_method: :patch, turbo_confirm: "Are you sure you want to archive this project?" },
                      class: "text-yellow-600 hover:text-yellow-500 text-sm font-medium" %>
                </div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Active
                </span>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="bg-white rounded-lg shadow p-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No active projects</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating your first project.</p>
        <div class="mt-6">
          <%= link_to "Create Project", new_project_path,
              class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Archived Projects -->
  <% if @archived_projects.any? %>
    <div>
      <h2 class="text-xl font-semibold text-gray-900 mb-4">Archived Projects</h2>
      <div class="bg-white rounded-lg shadow">
        <div class="divide-y divide-gray-200">
          <% @archived_projects.each do |project| %>
            <div class="px-6 py-4 hover:bg-gray-50 transition-colors duration-150">
              <div class="flex justify-between items-center">
                <div class="flex items-center space-x-3">
                  <span class="inline-block w-3 h-3 rounded-full"
                        style="background-color: <%= project.color || '#6B7280' %>"></span>
                  <div>
                    <h3 class="text-sm font-semibold text-gray-900">
                      <%= link_to project.name, project_path(project), class: "hover:text-indigo-600" %>
                    </h3>
                    <% if project.client.present? %>
                      <p class="text-xs text-gray-500"><%= project.client.name %></p>
                    <% end %>
                  </div>
                </div>
                <div class="flex items-center space-x-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    Archived
                  </span>
                  <div class="flex space-x-2">
                    <%= link_to "Unarchive", archive_project_path(project),
                        data: { turbo_method: :patch, turbo_confirm: "Are you sure you want to unarchive this project?" },
                        class: "text-green-600 hover:text-green-500 text-sm font-medium" %>
                    <%= link_to "Delete", project_path(project),
                        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to permanently delete this project? This action cannot be undone." },
                        class: "text-red-600 hover:text-red-500 text-sm font-medium" %>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
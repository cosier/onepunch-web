<div class="min-h-screen bg-gray-50 flex flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md">
    <div class="text-center">
      <h1 class="text-3xl font-bold text-gray-900">Set Your Password</h1>
      <p class="mt-2 text-sm text-gray-600">
        Create a password to enable email login alongside your Google sign-in.
      </p>
    </div>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
      <%= form_with model: @user, url: settings_password_setup_path, local: true,
                    data: { controller: "password-strength" } do |f| %>

        <% if @user.errors.any? %>
          <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
            <ul class="list-disc list-inside text-sm">
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="space-y-6">
          <!-- Password Field -->
          <div>
            <label for="password" class="block text-sm font-medium text-gray-700">
              New Password
            </label>
            <div class="mt-1 relative">
              <%= f.password_field :password,
                  class: "appearance-none block w-full px-3 py-2 pr-10 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                  placeholder: "Enter your password",
                  data: {
                    "password-strength-target": "password",
                    action: "input->password-strength#checkStrength"
                  } %>
              <button type="button"
                      class="absolute inset-y-0 right-0 pr-3 flex items-center"
                      data-action="click->password-strength#toggleVisibility"
                      data-password-strength-target="toggleButton">
                <%= icon "eye", class: "h-5 w-5 text-gray-400", data: { "password-strength-target": "toggleIcon" } %>
              </button>
            </div>
          </div>

          <!-- Password Strength Indicator -->
          <div>
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm text-gray-600">Password Strength:</span>
              <span data-password-strength-target="strengthText" class="text-sm font-medium text-gray-500">None</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2">
              <div data-password-strength-target="strengthBar"
                   class="h-full rounded-full transition-all duration-300 bg-gray-200"
                   style="width: 0%"></div>
            </div>
          </div>

          <!-- Password Requirements -->
          <div class="space-y-2">
            <p class="text-xs text-gray-600 font-medium uppercase tracking-wide">Requirements:</p>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div class="flex items-center text-gray-400" data-password-strength-target="lengthRequirement">
                <%= icon "circle", class: "h-4 w-4 mr-1.5 text-gray-300" %>
                At least 8 characters
              </div>
              <div class="flex items-center text-gray-400" data-password-strength-target="uppercaseRequirement">
                <%= icon "circle", class: "h-4 w-4 mr-1.5 text-gray-300" %>
                One uppercase letter
              </div>
              <div class="flex items-center text-gray-400" data-password-strength-target="lowercaseRequirement">
                <%= icon "circle", class: "h-4 w-4 mr-1.5 text-gray-300" %>
                One lowercase letter
              </div>
              <div class="flex items-center text-gray-400" data-password-strength-target="numberRequirement">
                <%= icon "circle", class: "h-4 w-4 mr-1.5 text-gray-300" %>
                One number
              </div>
              <div class="flex items-center text-gray-400" data-password-strength-target="specialRequirement">
                <%= icon "circle", class: "h-4 w-4 mr-1.5 text-gray-300" %>
                One special character
              </div>
            </div>
          </div>

          <!-- Password Confirmation -->
          <div>
            <label for="password_confirmation" class="block text-sm font-medium text-gray-700">
              Confirm Password
            </label>
            <div class="mt-1">
              <%= f.password_field :password_confirmation,
                  class: "appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm placeholder-gray-400 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm",
                  placeholder: "Confirm your password",
                  data: {
                    "password-strength-target": "confirmation",
                    action: "input->password-strength#checkMatch"
                  } %>
            </div>
            <div class="mt-2">
              <div class="flex items-center text-gray-400 text-sm" data-password-strength-target="matchRequirement">
                <%= icon "circle", class: "h-4 w-4 mr-1.5 text-gray-300" %>
                Passwords match
              </div>
            </div>
          </div>

          <!-- Submit Button -->
          <div>
            <%= f.submit "Set Password",
                class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 opacity-50 cursor-not-allowed",
                disabled: true,
                data: { "password-strength-target": "submitButton" } %>
          </div>

          <!-- Cancel Link -->
          <div class="text-center">
            <%= link_to "Cancel", settings_account_path,
                class: "text-sm text-indigo-600 hover:text-indigo-500" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Info Box -->
    <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <%= icon "info", class: "h-5 w-5 text-blue-400" %>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-blue-800">Why set a password?</h3>
          <div class="mt-2 text-sm text-blue-700">
            <p>Setting a password allows you to:</p>
            <ul class="list-disc list-inside mt-1">
              <li>Sign in with email and password</li>
              <li>Access your account if Google sign-in is unavailable</li>
              <li>Improve your account security with multiple authentication methods</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
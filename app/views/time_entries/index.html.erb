<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Time Entries</h1>
        <p class="text-gray-600 mt-1">Track and manage your time entries</p>
      </div>
      <div class="flex items-center space-x-4">
        <%= link_to "New Entry", new_time_entry_path,
            class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>
  </div>

  <!-- Weekly View Widget -->
  <div class="bg-white rounded-lg shadow mb-6">
    <%= render "shared/weekly_view", 
        daily_breakdown: @daily_breakdown, 
        weekly_breakdown: @weekly_breakdown,
        standalone: true %>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow mb-6"
       data-controller="time-entries-filter"
       data-time-entries-filter-projects-by-org-value="<%= @projects_by_org.to_json %>">
    <div class="p-6">
      <%= form_with url: time_entries_path, method: :get, local: true,
            data: { time_entries_filter_target: "form" },
            class: "space-y-4" do |form| %>

        <!-- Organization Filter (Multi-Select) -->
        <div>
          <%= form.label :organization_ids, "Organizations", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :organization_ids,
                options_for_select(@all_organizations.map { |org| [org.display_name, org.id] }, @selected_organizations.pluck(:id)),
                {},
                {
                  multiple: true,
                  data: {
                    controller: "slim-select",
                    slim_select_placeholder_value: "Select organizations...",
                    slim_select_allow_deselect_value: true,
                    slim_select_close_on_select_value: false,
                    time_entries_filter_target: "organizationSelect",
                    action: "slim-select:change->time-entries-filter#organizationChanged"
                  },
                  class: "mt-1 block w-full"
                } %>
          <p class="mt-1 text-xs text-gray-500">Leave empty to see all time entries from all organizations</p>
        </div>

        <!-- Project Filter (Dynamic) -->
        <div>
          <%= form.label :project_id, "Project", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :project_id,
                grouped_options_for_select(
                  @projects_by_org.map { |org_id, data|
                    [data[:name], data[:projects].map { |p| [p[:name], p[:id]] }]
                  },
                  params[:project_id]
                ),
                { prompt: "All projects" },
                {
                  data: {
                    controller: "slim-select",
                    slim_select_placeholder_value: "All projects",
                    slim_select_allow_deselect_value: true,
                    slim_select_close_on_select_value: true,
                    time_entries_filter_target: "projectSelect",
                    action: "slim-select:change->time-entries-filter#projectChanged"
                  },
                  class: "mt-1 block w-full"
                } %>
        </div>

        <!-- Date Filter -->
        <div>
          <%= form.label :date, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.date_field :date,
                value: params[:date],
                onchange: "this.form.requestSubmit()",
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>

        <!-- Action Buttons -->
        <div class="flex items-center space-x-3 pt-2">
          <%= form.submit "Apply Filters", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-4 rounded-md shadow-sm" %>
          <button type="button"
                  data-action="time-entries-filter#clearFilters"
                  class="bg-gray-300 hover:bg-gray-400 text-gray-700 font-medium py-2 px-4 rounded-md">
            Clear Filters
          </button>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Time Entries List with Modal -->
  <div data-controller="modal">
    <!-- Time Entries Section -->
    <div class="bg-white rounded-lg shadow">
      <% if @time_entries.any? %>
        <div id="time-entries-list" class="divide-y divide-gray-200">
          <% @time_entries.each do |entry| %>
            <%= render "time_entries/entry_card", entry: entry %>
          <% end %>
        </div>

        <!-- Pagination would go here if implemented -->
      <% else %>
        <div class="px-6 py-12 text-center">
          <%= icon "clock", class: "mx-auto h-12 w-12 text-gray-400" %>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No time entries found</h3>
          <p class="mt-1 text-sm text-gray-500">
            <% if params[:date].present? || params[:project_id].present? %>
              Try adjusting your filters or
              <%= link_to "view all entries", time_entries_path, class: "text-indigo-600 hover:text-indigo-500" %>.
            <% else %>
              Get started by creating a new time entry or using the timer.
            <% end %>
          </p>
          <div class="mt-6">
            <%= link_to "Create New Entry", new_time_entry_path,
                class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Include the modal inside the controller scope -->
    <%= render "shared/modal" %>
  </div>
</div>
<%# app/views/settings/api_tokens/_token.html.erb %>
<div id="<%= dom_id(token) %>" class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:bg-gray-50" data-controller="api-token">
  <div class="flex-1">
    <div class="flex items-center gap-3">
      <div class="flex-shrink-0">
        <div class="h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
          <svg class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
      </div>

      <div class="flex-1 min-w-0">
        <h3 class="text-sm font-medium text-gray-900 truncate"><%= token.name %></h3>
        <div class="mt-1 flex items-center gap-3">
          <button type="button"
                  data-action="click->api-token#copyMaskedToken"
                  data-api-token-masked-value="<%= token.mask_token %>"
                  class="text-xs text-gray-500 hover:text-gray-700 font-mono inline-flex items-center gap-1">
            <%= token.mask_token %>
            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </button>

          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-<%= token.status_color %>-100 text-<%= token.status_color %>-800">
            <%= token.status.titleize %>
          </span>
        </div>

        <div class="mt-2 flex items-center gap-4 text-xs text-gray-500">
          <span>Created <%= time_ago_in_words(token.created_at) %> ago</span>
          <% if token.last_used_at %>
            <span>Last used <%= time_ago_in_words(token.last_used_at) %> ago</span>
          <% else %>
            <span>Never used</span>
          <% end %>
          <% if token.expires_at %>
            <span class="text-amber-600">Expires <%= token.expires_at.strftime("%b %d, %Y") %></span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="flex-shrink-0 ml-4">
    <%= button_to settings_api_token_path(token),
        method: :delete,
        data: {
          turbo_confirm: "Are you sure you want to revoke this token? Applications using this token will stop working.",
          turbo_method: :delete
        },
        class: "inline-flex items-center px-3 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
      <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
      Revoke
    <% end %>
  </div>
</div>

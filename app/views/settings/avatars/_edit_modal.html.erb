<div data-avatar-modal-target="modal" class="hidden">
  <!-- Background backdrop -->
  <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity opacity-0"
       data-avatar-modal-target="backdrop"
       data-action="click->avatar-modal#handleBackdropClick"></div>

  <!-- Modal panel -->
  <div class="fixed inset-0 z-10 overflow-y-auto">
    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95"
           data-avatar-modal-target="panel">

        <!-- Modal header -->
        <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
          <div class="sm:flex sm:items-start">
            <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-indigo-100 sm:mx-0 sm:h-10 sm:w-10">
              <svg class="h-6 w-6 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
              <h3 class="text-base font-semibold leading-6 text-gray-900">Change Avatar</h3>
              <p class="text-sm text-gray-500 mt-2">Upload a new profile picture or revert to your Google profile picture.</p>
            </div>
          </div>
        </div>

        <!-- Modal body -->
        <div class="px-4 pb-4 sm:px-6">
          <!-- Current avatar display -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Current Avatar</label>
            <%= render 'settings/avatars/preview', user: current_user %>
          </div>

          <!-- Upload new avatar -->
          <div class="mb-6" data-controller="dropzone"
               data-dropzone-max-size-value="5242880"
               data-dropzone-accepted-formats-value='["image/jpeg", "image/png", "image/gif", "image/webp"]'>
            <%= form_with url: settings_avatar_path, method: :patch, multipart: true, html: { data: { "dropzone-target": "form" } } do |f| %>
              <label class="block text-sm font-medium text-gray-700 mb-2">Upload New Avatar</label>

              <div data-action="click->dropzone#handleClick"
                   class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-indigo-500 cursor-pointer transition-colors">

                <!-- Hidden file input -->
                <input type="file"
                       name="avatar"
                       accept="image/*"
                       class="hidden"
                       data-dropzone-target="input"
                       data-action="change->dropzone#handleFileSelect">

                <!-- Preview -->
                <img class="hidden mx-auto h-32 w-32 rounded-full object-cover mb-4"
                     data-dropzone-target="preview">

                <!-- Placeholder -->
                <div data-dropzone-target="placeholder">
                  <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                    <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <p class="mt-1 text-sm text-gray-600">Click to upload or drag and drop</p>
                  <p class="text-xs text-gray-500">PNG, JPG, GIF or WebP up to 5MB</p>
                </div>

                <!-- Filename display -->
                <p class="hidden text-sm text-gray-600" data-dropzone-target="filename"></p>
              </div>

              <div class="flex justify-end mt-4">
                <button type="submit"
                        class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                  <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                  </svg>
                  Upload Avatar
                </button>
              </div>
            <% end %>
          </div>

          <!-- Divider -->
          <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-gray-300"></div>
            </div>
            <div class="relative flex justify-center text-sm">
              <span class="bg-white px-2 text-gray-500">Or</span>
            </div>
          </div>

          <!-- Avatar options -->
          <div class="space-y-3">
            <% if current_user.avatar_url.present? && (!current_user.active_avatar || current_user.active_avatar.source != 'google') %>
              <!-- Revert to Google avatar -->
              <%= button_to revert_settings_avatar_path,
                  method: :post,
                  class: "w-full flex items-center justify-between px-4 py-3 border border-gray-300 rounded-lg hover:bg-gray-50" do %>
                <div class="flex items-center space-x-3">
                  <img src="<%= current_user.avatar_url %>"
                       alt="Google profile"
                       class="h-10 w-10 rounded-full object-cover"
                       onerror="this.onerror=null; this.src='<%= current_user.gravatar_url %>'">
                  <div class="text-left">
                    <p class="text-sm font-medium text-gray-900">Use Google Profile Picture</p>
                    <p class="text-xs text-gray-500">Revert to your Google account picture</p>
                  </div>
                </div>
                <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
            <% end %>

            <% if current_user.active_avatar && current_user.active_avatar.image.attached? %>
              <!-- Remove avatar -->
              <%= button_to settings_avatar_path,
                  method: :delete,
                  data: { confirm: "Are you sure you want to remove your avatar?" },
                  class: "w-full flex items-center justify-between px-4 py-3 border border-red-300 rounded-lg hover:bg-red-50" do %>
                <div class="flex items-center space-x-3">
                  <div class="h-10 w-10 bg-red-100 rounded-full flex items-center justify-center">
                    <svg class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </div>
                  <div class="text-left">
                    <p class="text-sm font-medium text-red-900">Remove Avatar</p>
                    <p class="text-xs text-red-700">Delete your uploaded avatar</p>
                  </div>
                </div>
                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Modal footer -->
        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
          <button type="button"
                  data-action="click->avatar-modal#close"
                  class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
<div id="timer-status" class="bg-white rounded-lg shadow p-6">
  <% if @current_timer %>
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">Timer running for</p>
        <p class="text-lg font-semibold text-gray-900">
          <%= @current_timer.project.name %>
        </p>
        <p class="text-2xl font-mono text-indigo-600" data-timer-display>
          <% if @current_timer.running? %>
            <%= @current_timer.formatted_duration %>
          <% else %>
            <%= format_duration(@current_timer.duration || 0) %>
          <% end %>
        </p>
      </div>
      <button data-timer-stop="<%= @current_timer.id %>"
              class="px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
        Stop Timer
      </button>
    </div>
  <% else %>
    <p class="text-gray-500 text-center">No timer running</p>
  <% end %>
</div>
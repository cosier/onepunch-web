<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Asana Integration</h1>
    <p class="mt-2 text-sm text-gray-600">
      Connect your Asana account to import tasks and track time directly from your projects.
    </p>
  </div>

  <!-- Connection Status Card -->
  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-6 py-5">
      <% if @asana_connected %>
        <!-- Connected State Header -->
        <div class="flex items-start justify-between mb-6">
          <div class="flex items-start space-x-3">
            <div class="flex-shrink-0">
              <svg class="h-12 w-12 text-green-500" fill="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" fill="currentColor" opacity="0.2"/>
                <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" fill="none"/>
              </svg>
            </div>
            <div>
              <h3 class="text-lg font-medium text-gray-900">Connected to Asana</h3>
              <p class="mt-1 text-sm text-gray-500">
                Your Asana account is successfully connected.
              </p>
              <% if @asana_credential&.expires_at %>
                <p class="mt-2 text-xs text-gray-500">
                  Token expires: <%= @asana_credential.expires_at.strftime('%B %d, %Y at %I:%M %p') %>
                </p>
              <% end %>
            </div>
          </div>
          <div class="flex space-x-3">
            <%= button_to "Sync Now",
                settings_integrations_sync_asana_path,
                method: :post,
                class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            <%= button_to "Disconnect",
                settings_integrations_disconnect_asana_path,
                method: :delete,
                data: { confirm: "Are you sure you want to disconnect Asana?" },
                class: "inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          </div>
        </div>

        <!-- Workspaces List -->
        <% if @workspaces&.any? %>
          <div class="border-t border-gray-200 pt-6">
            <h4 class="text-md font-medium text-gray-900 mb-4">Your Workspaces</h4>
            <div class="space-y-4">
              <% @workspaces.each do |workspace| %>
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-center justify-between">
                    <div class="flex-1">
                      <div class="flex items-center">
                        <h5 class="text-sm font-medium text-gray-900"><%= workspace.name %></h5>
                        <% if workspace.is_organization %>
                          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            Organization
                          </span>
                        <% end %>
                      </div>
                      <div class="mt-1 flex items-center text-xs text-gray-500">
                        <span><%= workspace.asana_projects.count %> projects</span>
                        <span class="mx-2">•</span>
                        <% if workspace.last_synced_at %>
                          <span>Last synced: <%= time_ago_in_words(workspace.last_synced_at) %> ago</span>
                        <% else %>
                          <span class="text-yellow-600">Not synced yet</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="border-t border-gray-200 pt-6">
            <div class="text-center py-4">
              <p class="text-sm text-gray-500">No workspaces synced yet. Click "Sync Now" to fetch your workspaces.</p>
            </div>
          </div>
        <% end %>

        <!-- Development Tools (only in development) -->
        <% if Rails.env.development? %>
          <div class="border-t border-gray-200 mt-6 pt-6">
            <h4 class="text-md font-medium text-gray-900 mb-4">🛠️ Development Tools</h4>
            <div class="bg-gray-50 rounded-lg p-4 space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-700">Test API Connection</span>
                <button
                  onclick="testAsanaConnection()"
                  class="inline-flex items-center px-3 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50">
                  Test
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-700">List Workspaces (API)</span>
                <button
                  onclick="listAsanaWorkspaces()"
                  class="inline-flex items-center px-3 py-1 border border-gray-300 shadow-sm text-xs font-medium rounded text-gray-700 bg-white hover:bg-gray-50">
                  List
                </button>
              </div>
              <div id="dev-output" class="mt-4 p-3 bg-gray-900 text-gray-100 rounded text-xs font-mono hidden overflow-auto max-h-64">
                <pre id="dev-output-content"></pre>
              </div>
            </div>
          </div>

          <script>
            async function testAsanaConnection() {
              const output = document.getElementById('dev-output');
              const content = document.getElementById('dev-output-content');
              try {
                const response = await fetch('/settings/integrations/test_connection');
                const data = await response.json();
                content.textContent = JSON.stringify(data, null, 2);
                output.classList.remove('hidden');
              } catch (error) {
                content.textContent = `Error: ${error.message}`;
                output.classList.remove('hidden');
              }
            }

            async function listAsanaWorkspaces() {
              const output = document.getElementById('dev-output');
              const content = document.getElementById('dev-output-content');
              try {
                const response = await fetch('/settings/integrations/list_workspaces');
                const data = await response.json();
                content.textContent = JSON.stringify(data, null, 2);
                output.classList.remove('hidden');
              } catch (error) {
                content.textContent = `Error: ${error.message}`;
                output.classList.remove('hidden');
              }
            }
          </script>
        <% end %>

      <% else %>
        <!-- Not Connected State -->
        <div class="text-center py-8">
          <svg class="mx-auto h-16 w-16 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
          <h3 class="mt-4 text-lg font-medium text-gray-900">Connect Asana</h3>
          <p class="mt-2 text-sm text-gray-500 max-w-md mx-auto">
            Connect your Asana account to sync tasks and track time across your projects seamlessly.
          </p>
          <div class="mt-6">
            <%= link_to asana_oauth_authorize_path,
                class: "inline-flex items-center px-6 py-3 border border-transparent shadow-sm text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
              <svg class="-ml-1 mr-3 h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="2"/>
                <circle cx="19" cy="12" r="2"/>
                <circle cx="5" cy="12" r="2"/>
              </svg>
              Connect Asana Account
            <% end %>
          </div>
        </div>

        <!-- Features List -->
        <div class="mt-8 border-t border-gray-200 pt-8">
          <h4 class="text-sm font-medium text-gray-900 mb-4">What you can do with Asana integration:</h4>
          <ul class="space-y-3">
            <li class="flex items-start">
              <svg class="h-5 w-5 text-green-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="ml-3 text-sm text-gray-700">Import tasks from Asana projects</span>
            </li>
            <li class="flex items-start">
              <svg class="h-5 w-5 text-green-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="ml-3 text-sm text-gray-700">Track time on Asana tasks directly</span>
            </li>
            <li class="flex items-start">
              <svg class="h-5 w-5 text-green-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="ml-3 text-sm text-gray-700">Sync project updates automatically</span>
            </li>
            <li class="flex items-start">
              <svg class="h-5 w-5 text-green-500 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span class="ml-3 text-sm text-gray-700">Generate invoices from Asana project time</span>
            </li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Back Button -->
  <div class="mt-6">
    <%= link_to "← Back to Settings", settings_path, class: "text-sm text-indigo-600 hover:text-indigo-500" %>
  </div>
</div>
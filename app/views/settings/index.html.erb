<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Organization Switcher at top of settings -->
  <div class="mb-8 pb-6 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Settings</h1>
        <p class="mt-2 text-sm text-gray-600">
          Managing settings for: <span class="font-semibold text-gray-900"><%= @organization.display_name %></span>
        </p>
      </div>

      <% if current_user.organizations.count > 1 %>
        <div class="relative" data-controller="dropdown">
          <button data-action="click->dropdown#toggle"
                  class="flex items-center space-x-2 px-4 py-2 bg-white border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            <span><%= @organization.display_name %></span>
            <svg class="ml-2 -mr-0.5 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div data-dropdown-target="menu"
               class="hidden absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
            <div class="py-1">
              <% @organizations.each do |org| %>
                <%= link_to switch_organization_path(org),
                    data: { turbo_method: :patch },
                    class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-100' if org == @organization}" do %>
                  <span class="flex-1"><%= org.display_name %></span>
                  <% if org == @organization %>
                    <svg class="h-4 w-4 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Settings Navigation Tabs -->
  <div class="mb-6">
    <nav class="flex space-x-8">
      <%= link_to "Account", settings_account_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm #{'border-indigo-500 text-indigo-600' if current_page?(settings_path)}" %>
      <%= link_to "Organization", settings_organization_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" %>
      <%= link_to "Billing", settings_billing_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" %>
    </nav>
  </div>

  <!-- General Settings Content -->
  <div class="bg-white shadow rounded-lg">
    <div class="p-6">
      <h2 class="text-lg font-medium text-gray-900 mb-4">General Settings</h2>

      <div class="space-y-6">
        <!-- Time Zone -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Time Zone</label>
          <select class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
            <option>UTC</option>
            <option>America/New_York</option>
            <option>America/Los_Angeles</option>
            <option>Europe/London</option>
            <option>Europe/Paris</option>
            <option>Asia/Tokyo</option>
          </select>
        </div>

        <!-- Currency -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Currency</label>
          <select class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
            <option value="USD">USD - US Dollar</option>
            <option value="EUR">EUR - Euro</option>
            <option value="GBP">GBP - British Pound</option>
            <option value="CAD">CAD - Canadian Dollar</option>
            <option value="AUD">AUD - Australian Dollar</option>
          </select>
        </div>

        <!-- Date Format -->
        <div>
          <label class="block text-sm font-medium text-gray-700">Date Format</label>
          <select class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md">
            <option>MM/DD/YYYY</option>
            <option>DD/MM/YYYY</option>
            <option>YYYY-MM-DD</option>
          </select>
        </div>

        <!-- Notification Settings -->
        <div>
          <h3 class="text-sm font-medium text-gray-700 mb-3">Notifications</h3>
          <div class="space-y-3">
            <label class="flex items-center">
              <input type="checkbox" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" checked>
              <span class="ml-2 text-sm text-gray-700">Email notifications</span>
            </label>
            <label class="flex items-center">
              <input type="checkbox" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
              <span class="ml-2 text-sm text-gray-700">Slack notifications</span>
            </label>
          </div>
        </div>

        <!-- Save Button -->
        <div class="flex justify-end pt-4">
          <button class="px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Save Changes
          </button>
        </div>
      </div>
    </div>
  </div>

  <% if !@organization.personal? %>
    <!-- Create Organization Link for Business Orgs -->
    <div class="mt-8 text-center">
      <%= link_to "Create New Organization", new_organization_path,
          class: "text-indigo-600 hover:text-indigo-500 text-sm font-medium" %>
    </div>
  <% end %>
</div>
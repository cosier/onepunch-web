<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="max-w-md mx-auto">
    <div class="bg-white shadow rounded-lg p-6">
      <!-- Application Info -->
      <div class="text-center mb-6">
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Authorize Application</h1>
        <p class="text-gray-600">
          <strong><%= @application.name %></strong>
          is requesting access to your OnePunch account
        </p>
      </div>
      <!-- User Info -->
      <div class="bg-gray-50 rounded-lg p-4 mb-6">
        <div class="flex items-center">
          <% if current_user.avatar_url.present? %>
            <%= image_tag current_user.avatar_url, class: "h-10 w-10 rounded-full mr-3" %>
          <% else %>
            <div
              class="
                h-10 w-10 rounded-full bg-indigo-600 flex items-center justify-center text-white
                font-medium mr-3
              "
            >
              <%= current_user.first_name&.first&.upcase || "?" %>
            </div>
          <% end %>
          <div>
            <p class="text-sm font-medium text-gray-900"><%= current_user.full_name %></p>
            <p class="text-sm text-gray-500"><%= current_user.email %></p>
          </div>
        </div>
      </div>
      <!-- Permissions -->
      <div class="mb-6">
        <h2 class="text-sm font-medium text-gray-900 mb-3">This application will be able to:</h2>
        <ul class="space-y-2">
          <% @scopes.each do |scope| %>
            <li class="flex items-start">
              <svg
                class="h-5 w-5 text-green-500 mr-2 mt-0.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              <span class="text-sm text-gray-700">
                <% case scope
                   when "api" %>
                  Access your time entries, projects, and account information
                <% when "read" %>
                  Read your time entries and projects
                <% when "write" %>
                  Create and modify time entries and projects
                <% else %>
                  <%= scope.humanize %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      </div>
      <!-- Authorization Form -->
      <%= form_with url: oauth_authorize_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <!-- Preserve OAuth parameters -->
        <%= hidden_field_tag :client_id, params[:client_id] %>
        <%= hidden_field_tag :redirect_uri, params[:redirect_uri] %>
        <%= hidden_field_tag :response_type, params[:response_type] %>
        <%= hidden_field_tag :scope, params[:scope] %>
        <%= hidden_field_tag :state, params[:state] %>
        <%= hidden_field_tag :code_challenge, params[:code_challenge] %>
        <%= hidden_field_tag :code_challenge_method, params[:code_challenge_method] %>

        <div class="flex space-x-3">
          <%= f.button type: :submit, name: :authorize, value: "true", class: "flex-1 cursor-pointer bg-indigo-600 text-white py-2 px-4 rounded-lg hover:bg-indigo-700 font-medium" do %>
            Authorize
          <% end %>
          <%= f.button type: :submit, name: :authorize, value: "false", class: "flex-1 bg-white text-gray-700 py-2 px-4 rounded-lg border border-gray-300 hover:bg-gray-50 font-medium" do %>
            Cancel
          <% end %>
        </div>
      <% end %>
      <!-- Security Notice -->
      <p class="mt-4 text-xs text-gray-500 text-center">
        Make sure you trust this application before authorizing access
      </p>
    </div>
  </div>
</div>

<div class="fixed inset-0 z-50 overflow-y-auto" data-controller="onboarding-wizard">
  <div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
    <!-- Background overlay -->
    <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity"></div>

    <!-- Modal panel -->
    <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-2xl">
      <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
        <!-- Progress bar -->
        <div class="mb-8">
          <div class="flex items-center justify-between">
            <% (1..5).each do |step| %>
              <div class="flex items-center <%= 'flex-1' unless step == 5 %>">
                <div data-onboarding-wizard-target="stepIndicator"
                     data-step="<%= step %>"
                     class="flex h-10 w-10 items-center justify-center rounded-full <%= step == 1 ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-600' %>">
                  <%= step %>
                </div>
                <% unless step == 5 %>
                  <div class="flex-1 h-1 mx-2 <%= step == 1 ? 'bg-indigo-200' : 'bg-gray-200' %>"></div>
                <% end %>
              </div>
            <% end %>
          </div>
          <div class="mt-2 flex justify-between text-xs text-gray-600">
            <span>Organization</span>
            <span>Profile</span>
            <span>Project</span>
            <span>Team</span>
            <span>Complete</span>
          </div>
        </div>

        <%= form_with model: @organization, url: onboarding_index_path,
                      data: {
                        onboarding_wizard_target: "form",
                        action: "submit->onboarding-wizard#submit"
                      },
                      class: "space-y-6" do |form| %>

          <!-- Step 1: Organization Details -->
          <div data-onboarding-wizard-target="step" data-step="1">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Welcome to OnePunch! 🎉</h2>
              <p class="mt-2 text-gray-600">Let's set up your organization in just a few steps</p>
            </div>

            <div class="space-y-4">
              <div>
                <%= form.label :name, "Organization Name", class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :name,
                    required: true,
                    placeholder: "Acme Corporation",
                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <%= form.label :industry, class: "block text-sm font-medium text-gray-700" %>
                  <%= form.select :industry,
                      options_for_select([
                        ["Technology", "technology"],
                        ["Consulting", "consulting"],
                        ["Design", "design"],
                        ["Marketing", "marketing"],
                        ["Finance", "finance"],
                        ["Healthcare", "healthcare"],
                        ["Education", "education"],
                        ["Other", "other"]
                      ]),
                      { prompt: "Select Industry" },
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>

                <div>
                  <%= form.label :size, "Company Size", class: "block text-sm font-medium text-gray-700" %>
                  <%= form.select :size,
                      options_for_select([
                        ["Just me", "solo"],
                        ["2-10", "small"],
                        ["11-50", "medium"],
                        ["50+", "large"]
                      ]),
                      { prompt: "Select Size" },
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>

              <div>
                <%= form.label :website, class: "block text-sm font-medium text-gray-700" %>
                <%= form.text_field :website,
                    placeholder: "https://example.com",
                    class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
              </div>
            </div>
          </div>

          <!-- Step 2: Profile Setup -->
          <div data-onboarding-wizard-target="step" data-step="2" class="hidden">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Set Up Your Profile</h2>
              <p class="mt-2 text-gray-600">Tell us a bit about yourself</p>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Your Role</label>
                <select class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                  <option>Founder / Owner</option>
                  <option>Manager</option>
                  <option>Developer</option>
                  <option>Designer</option>
                  <option>Consultant</option>
                  <option>Freelancer</option>
                  <option>Other</option>
                </select>
              </div>

              <div class="grid grid-cols-2 gap-4">
                <div>
                  <%= form.label :timezone, class: "block text-sm font-medium text-gray-700" %>
                  <%= form.select :timezone,
                      options_for_select([
                        ["Pacific Time", "America/Los_Angeles"],
                        ["Mountain Time", "America/Denver"],
                        ["Central Time", "America/Chicago"],
                        ["Eastern Time", "America/New_York"],
                        ["UTC", "UTC"]
                      ]),
                      { selected: "America/New_York" },
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>

                <div>
                  <%= form.label :currency, class: "block text-sm font-medium text-gray-700" %>
                  <%= form.select :currency,
                      options_for_select([
                        ["USD - US Dollar", "USD"],
                        ["EUR - Euro", "EUR"],
                        ["GBP - British Pound", "GBP"],
                        ["CAD - Canadian Dollar", "CAD"],
                        ["AUD - Australian Dollar", "AUD"]
                      ]),
                      { selected: "USD" },
                      class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 3: First Project -->
          <div data-onboarding-wizard-target="step" data-step="3" class="hidden">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Create Your First Project</h2>
              <p class="mt-2 text-gray-600">Projects help you organize and track your time</p>
            </div>

            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700">Project Name</label>
                <input type="text"
                       placeholder="Website Redesign"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Client Name</label>
                <input type="text"
                       placeholder="Acme Corp (optional)"
                       class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Hourly Rate</label>
                <div class="mt-1 relative rounded-md shadow-sm">
                  <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                    <span class="text-gray-500 sm:text-sm">$</span>
                  </div>
                  <input type="number"
                         placeholder="150.00"
                         class="block w-full rounded-md border-gray-300 pl-7 pr-12 focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                  <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3">
                    <span class="text-gray-500 sm:text-sm">/hour</span>
                  </div>
                </div>
              </div>

              <div class="bg-blue-50 p-4 rounded-lg">
                <p class="text-sm text-blue-800">
                  💡 <strong>Tip:</strong> You can always create more projects later from your dashboard.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 4: Invite Team -->
          <div data-onboarding-wizard-target="step" data-step="4" class="hidden">
            <div class="text-center mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Invite Your Team</h2>
              <p class="mt-2 text-gray-600">Collaborate with others by inviting them to your organization</p>
            </div>

            <div class="space-y-4">
              <div data-controller="team-invites">
                <div data-team-invites-target="container" class="space-y-3">
                  <div class="flex gap-2">
                    <input type="email"
                           placeholder="teammate@example.com"
                           class="flex-1 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                    <select class="rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                      <option>Member</option>
                      <option>Admin</option>
                    </select>
                  </div>
                </div>

                <button type="button"
                        data-action="click->team-invites#add"
                        class="mt-3 text-sm text-indigo-600 hover:text-indigo-500">
                  + Add another teammate
                </button>
              </div>

              <div class="bg-gray-50 p-4 rounded-lg">
                <p class="text-sm text-gray-600">
                  <strong>Skip for now?</strong> You can always invite team members later from the settings page.
                </p>
              </div>
            </div>
          </div>

          <!-- Step 5: Complete -->
          <div data-onboarding-wizard-target="step" data-step="5" class="hidden">
            <div class="text-center">
              <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-green-100 mb-4">
                <svg class="h-12 w-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              <h2 class="text-2xl font-bold text-gray-900">You're All Set!</h2>
              <p class="mt-2 text-gray-600">Your organization is ready. Let's start tracking time!</p>

              <div class="mt-8 space-y-3 text-left bg-gray-50 p-4 rounded-lg">
                <h3 class="font-semibold text-gray-900">Quick Start Tips:</h3>
                <ul class="space-y-2 text-sm text-gray-600">
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2">✓</span>
                    Use the timer in the dashboard to track your time
                  </li>
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2">✓</span>
                    Create projects for different clients or work areas
                  </li>
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2">✓</span>
                    Generate invoices from your tracked time
                  </li>
                  <li class="flex items-start">
                    <span class="text-indigo-600 mr-2">✓</span>
                    Press <kbd class="px-2 py-1 bg-white rounded border">Cmd+K</kbd> to quickly switch organizations
                  </li>
                </ul>
              </div>
            </div>
          </div>

        <% end %>
      </div>

      <!-- Modal footer with navigation -->
      <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
        <button type="button"
                data-action="click->onboarding-wizard#next"
                data-onboarding-wizard-target="nextButton"
                class="inline-flex w-full justify-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 sm:ml-3 sm:w-auto">
          Next
        </button>
        <button type="button"
                data-action="click->onboarding-wizard#previous"
                data-onboarding-wizard-target="previousButton"
                class="mt-3 hidden inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
          Previous
        </button>
        <button type="button"
                data-action="click->onboarding-wizard#skip"
                data-onboarding-wizard-target="skipButton"
                class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-500 hover:text-gray-700 sm:mt-0 sm:w-auto">
          Skip this step
        </button>
      </div>
    </div>
  </div>
</div>
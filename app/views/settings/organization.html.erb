<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Organization Switcher at top of settings -->
  <div class="mb-8 pb-6 border-b border-gray-200">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Organization Settings</h1>
        <p class="mt-2 text-sm text-gray-600">
          Managing settings for: <span class="font-semibold text-gray-900"><%= @organization.display_name %></span>
        </p>
      </div>

      <% if current_user.organizations.count > 1 %>
        <div class="relative" data-controller="dropdown">
          <button data-action="click->dropdown#toggle"
                  class="flex items-center space-x-2 px-4 py-2 bg-white border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            <span><%= @organization.display_name %></span>
            <svg class="ml-2 -mr-0.5 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </button>

          <div data-dropdown-target="menu"
               class="hidden absolute right-0 mt-2 w-56 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 z-50">
            <div class="py-1">
              <% @organizations.each do |org| %>
                <%= link_to switch_organization_path(org),
                    data: { turbo_method: :patch },
                    class: "flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 #{'bg-gray-100' if org == @organization}" do %>
                  <span class="flex-1"><%= org.display_name %></span>
                  <% if org == @organization %>
                    <svg class="h-4 w-4 text-indigo-600" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Settings Navigation Tabs -->
  <div class="mb-6">
    <nav class="flex space-x-8">
      <%= link_to "General", settings_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" %>
      <%= link_to "Organization", settings_organization_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm border-indigo-500 text-indigo-600" %>
      <%= link_to "Profile", settings_profile_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" %>
      <%= link_to "Billing", settings_billing_path,
          class: "pb-3 px-1 border-b-2 font-medium text-sm border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300" %>
    </nav>
  </div>

  <!-- Flash Messages -->
  <% if notice.present? %>
    <div class="mb-4 rounded-md bg-green-50 p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm font-medium text-green-800"><%= notice %></p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Organization Settings Content -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Organization Details -->
    <div class="lg:col-span-2">
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Organization Details</h2>
        </div>

        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700">Organization Name</label>
              <p class="mt-1 text-sm text-gray-900"><%= @organization.name %></p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Organization Type</label>
              <p class="mt-1">
                <% if @organization.personal? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    Personal Organization
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    Business Organization
                  </span>
                <% end %>
              </p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Organization Size</label>
              <p class="mt-1 text-sm text-gray-900 capitalize"><%= @organization.size || 'Not specified' %></p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Currency</label>
              <p class="mt-1 text-sm text-gray-900"><%= @organization.currency || 'USD' %></p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Time Zone</label>
              <p class="mt-1 text-sm text-gray-900"><%= @organization.timezone || 'UTC' %></p>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700">Created</label>
              <p class="mt-1 text-sm text-gray-900"><%= @organization.created_at.strftime("%B %d, %Y") %></p>
            </div>
          </div>

          <% if current_user.admin_of?(@organization) %>
            <div class="pt-4 border-t border-gray-200">
              <%= link_to "View Organization Details", organization_path(@organization),
                  class: "inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Organization Settings (if exists) -->
      <% if @settings %>
        <div class="bg-white shadow rounded-lg mt-6">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Invoice Settings</h2>
          </div>

          <div class="p-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700">Invoice Prefix</label>
                <p class="mt-1 text-sm text-gray-900"><%= @settings.invoice_prefix %></p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Next Invoice Number</label>
                <p class="mt-1 text-sm text-gray-900"><%= @settings.next_invoice_number %></p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Default Hourly Rate</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= @settings.default_hourly_rate ? number_to_currency(@settings.default_hourly_rate) : 'Not set' %>
                </p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Tax Rate</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= @settings.tax_rate ? "#{@settings.tax_rate}%" : 'Not set' %>
                </p>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Members -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-base font-medium text-gray-900">Team Members</h3>
        </div>
        <div class="p-6">
          <div class="flex items-center justify-between mb-4">
            <span class="text-sm text-gray-600">Total Members</span>
            <span class="text-sm font-medium text-gray-900"><%= @organization.member_count %></span>
          </div>
          <% if current_user.admin_of?(@organization) %>
            <%= link_to "Manage Team", "#",
                class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <% end %>
        </div>
      </div>

      <!-- Subscription Status -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-base font-medium text-gray-900">Subscription</h3>
        </div>
        <div class="p-6">
          <div class="space-y-4">
            <div>
              <span class="text-sm text-gray-600">Status</span>
              <p class="mt-1">
                <% if @organization.trial? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Trial
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Active
                  </span>
                <% end %>
              </p>
            </div>

            <% if @organization.trial? && @organization.trial_ends_at.present? %>
              <div>
                <span class="text-sm text-gray-600">Trial Ends</span>
                <p class="mt-1 text-sm font-medium text-gray-900">
                  <%= @organization.trial_ends_at.strftime("%B %d, %Y") %>
                </p>
              </div>
            <% end %>

            <% if current_user.owner_of?(@organization) %>
              <%= link_to "Manage Billing", settings_billing_path,
                  class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Danger Zone -->
      <% if current_user.owner_of?(@organization) && !@organization.personal? %>
        <div class="bg-white shadow rounded-lg border border-red-200">
          <div class="px-6 py-4 border-b border-red-200 bg-red-50">
            <h3 class="text-base font-medium text-red-900">Danger Zone</h3>
          </div>
          <div class="p-6">
            <p class="text-sm text-gray-600 mb-4">
              Once you delete an organization, there is no going back. Please be certain.
            </p>
            <%= link_to "Delete Organization", organization_path(@organization),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will permanently delete the organization and all its data." },
                class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h1 class="text-2xl font-bold text-gray-900">Edit Organization</h1>
      <p class="mt-1 text-sm text-gray-600">Update your organization settings</p>
    </div>

    <%= form_with(model: @organization, local: true) do |form| %>
      <div class="p-6 space-y-6">
        <% if @organization.errors.any? %>
          <div class="rounded-md bg-red-50 p-4">
            <div class="flex">
              <div class="ml-3">
                <h3 class="text-sm font-medium text-red-800">
                  There were <%= pluralize(@organization.errors.count, "error") %> with your submission
                </h3>
                <div class="mt-2 text-sm text-red-700">
                  <ul class="list-disc space-y-1 pl-5">
                    <% @organization.errors.full_messages.each do |message| %>
                      <li><%= message %></li>
                    <% end %>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <div>
          <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
          <%= form.text_field :name,
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm",
              placeholder: "e.g., Acme Corp",
              disabled: @organization.is_personal? %>
          <% if @organization.is_personal? %>
            <p class="mt-1 text-sm text-gray-500">Personal organization names cannot be changed</p>
          <% end %>
        </div>

        <div>
          <%= form.label :size, "Organization Size", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :size,
              options_for_select([
                ['Solo (Just me)', 'solo'],
                ['Small (2-10 people)', 'small'],
                ['Medium (11-50 people)', 'medium'],
                ['Large (50+ people)', 'large']
              ], @organization.size),
              { prompt: 'Select organization size' },
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= form.label :currency, class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :currency,
              options_for_select([
                ['USD - US Dollar', 'USD'],
                ['EUR - Euro', 'EUR'],
                ['GBP - British Pound', 'GBP'],
                ['CAD - Canadian Dollar', 'CAD'],
                ['AUD - Australian Dollar', 'AUD']
              ], @organization.currency),
              {},
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <div>
          <%= form.label :timezone, "Time Zone", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :timezone,
              options_for_select([
                ['UTC', 'UTC'],
                ['Eastern Time (US & Canada)', 'America/New_York'],
                ['Central Time (US & Canada)', 'America/Chicago'],
                ['Mountain Time (US & Canada)', 'America/Denver'],
                ['Pacific Time (US & Canada)', 'America/Los_Angeles'],
                ['London', 'Europe/London'],
                ['Paris', 'Europe/Paris'],
                ['Tokyo', 'Asia/Tokyo'],
                ['Bangkok (+07:00)', 'Asia/Bangkok']
              ], @organization.timezone),
              {},
              class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>

        <% if !@organization.is_personal? %>
          <div class="rounded-md bg-yellow-50 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M8.485 3.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 3.495zM10 6a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 6zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-yellow-800">
                  Organization Information
                </h3>
                <div class="mt-2 text-sm text-yellow-700">
                  <p>
                    Organization ID: <%= @organization.slug %><br>
                    Members: <%= @organization.member_count %><br>
                    Created: <%= @organization.created_at.strftime("%B %d, %Y") %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="px-6 py-4 bg-gray-50 border-t border-gray-200 flex justify-between">
        <div>
          <% if !@organization.is_personal? && current_user.owner_of?(@organization) %>
            <%= link_to "Delete Organization", organization_path(@organization),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will permanently delete the organization and all its data." },
                class: "px-4 py-2 border border-red-300 rounded-md shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          <% end %>
        </div>
        <div class="flex space-x-3">
          <%= link_to "Cancel", settings_organization_path,
              class: "px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <%= form.submit "Save Changes",
              class: "px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
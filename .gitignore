# Ignore environment files
.env
.env.local
.env.*.local

# Ignore database files
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore all logfiles and tempfiles
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage files
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore master key for Rails credentials
/config/master.key
/config/credentials/*.key

# Ignore public uploads
/public/uploads
/public/assets

# Ignore node_modules if any JS packages are added
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore IDE files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Ignore test coverage
/coverage

# Ignore bundler config
/.bundle
/vendor/bundle

# Ignore byebug history
.byebug_history

# Ignore Android/iOS build artifacts
/android/
/ios/

# Ignore Tailwind build cache
/app/assets/builds/*
!/app/assets/builds/.keep

# Local development
.overmind.sock
.overmind.state
Procfile.dev.local

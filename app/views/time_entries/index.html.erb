<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Time Entries</h1>
        <p class="text-gray-600 mt-1">Track and manage your time entries</p>
      </div>
      <div class="flex items-center space-x-4">
        <%= link_to "New Entry", new_time_entry_path,
            class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white rounded-lg shadow mb-6">
    <div class="p-6">
      <%= form_with url: time_entries_path, method: :get, local: true, class: "flex items-end space-x-4" do |form| %>
        <div>
          <%= form.label :date, class: "block text-sm font-medium text-gray-700" %>
          <%= form.date_field :date,
                value: params[:date],
                class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
        </div>
        <div>
          <%= form.label :project_id, "Project", class: "block text-sm font-medium text-gray-700" %>
          <%= form.select :project_id,
                options_from_collection_for_select(@projects, :id, :name, params[:project_id]),
                { prompt: "All projects" },
                { class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" } %>
        </div>
        <div>
          <%= form.submit "Filter", class: "bg-gray-600 hover:bg-gray-700 text-white font-medium py-2 px-4 rounded-md" %>
          <%= link_to "Clear", time_entries_path, class: "ml-2 bg-gray-300 hover:bg-gray-400 text-gray-700 font-medium py-2 px-4 rounded-md" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Time Entries List -->
  <div class="bg-white rounded-lg shadow">
    <% if @time_entries.any? %>
      <div class="divide-y divide-gray-200">
        <% @time_entries.each do |entry| %>
          <div class="px-6 py-4 hover:bg-gray-50 transition-colors duration-150">
            <div class="flex justify-between items-start">
              <div class="flex-1">
                <div class="flex items-center space-x-2">
                  <span class="inline-block w-3 h-3 rounded-full"
                        style="background-color: <%= entry.project.color || '#6B7280' %>"></span>
                  <h3 class="text-sm font-semibold text-gray-900">
                    <%= entry.project.name %>
                  </h3>
                  <% if entry.billable? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                      Billable
                    </span>
                  <% end %>
                  <% if entry.running? %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
                      Running
                    </span>
                  <% end %>
                </div>
                <% if entry.description.present? %>
                  <p class="text-sm text-gray-600 mt-1"><%= entry.description %></p>
                <% end %>
                <div class="flex items-center space-x-4 mt-2 text-xs text-gray-500">
                  <span>
                    <%= entry.started_at.strftime("%b %d, %Y at %I:%M %p") %>
                  </span>
                  <% unless entry.running? %>
                    <span>
                      to <%= entry.ended_at&.strftime("%I:%M %p") %>
                    </span>
                  <% end %>
                </div>
              </div>
              <div class="flex items-center space-x-4 flex-shrink-0 ml-4">
                <div class="text-right">
                  <p class="text-lg font-semibold text-gray-900 font-mono">
                    <%= entry.running? ? "Running..." : entry.formatted_duration %>
                  </p>
                </div>
                <div class="flex items-center space-x-2">
                  <%= link_to "Edit", edit_time_entry_path(entry),
                      class: "text-indigo-600 hover:text-indigo-500 text-sm font-medium" %>
                  <%= link_to "Delete", time_entry_path(entry),
                      method: :delete,
                      data: { confirm: "Are you sure?" },
                      class: "text-red-600 hover:text-red-500 text-sm font-medium" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Pagination would go here if implemented -->
    <% else %>
      <div class="px-6 py-12 text-center">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-gray-900">No time entries found</h3>
        <p class="mt-1 text-sm text-gray-500">
          <% if params[:date].present? || params[:project_id].present? %>
            Try adjusting your filters or
            <%= link_to "view all entries", time_entries_path, class: "text-indigo-600 hover:text-indigo-500" %>.
          <% else %>
            Get started by creating a new time entry or using the timer.
          <% end %>
        </p>
        <div class="mt-6">
          <%= link_to "Create New Entry", new_time_entry_path,
              class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
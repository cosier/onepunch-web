<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <!-- Page Header -->
  <div class="mb-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= @organization.display_name %></h1>
        <p class="mt-2 text-sm text-gray-600">
          View and manage your organization details
        </p>
      </div>
    </div>
  </div>

  <!-- Organization Content -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main Content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Organization Details with Inline Editing -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Organization Details</h2>
        </div>

        <%= form_with model: @organization, data: { turbo: true, controller: "auto-submit" } do |f| %>
          <div class="p-6 space-y-6">
            <!-- Organization Name - Inline Editable -->
            <% if current_user.admin_of?(@organization) && !@organization.personal? %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Organization Name</label>
                <%= f.text_field :name,
                    data: { action: "blur->auto-submit#submit" },
                    class: "block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm" %>
                <p class="mt-1 text-xs text-gray-500">Click to edit, changes save automatically</p>
              </div>
            <% else %>
              <div>
                <label class="block text-sm font-medium text-gray-700">Organization Name</label>
                <p class="mt-1 text-sm text-gray-900"><%= @organization.name %></p>
              </div>
            <% end %>

            <!-- Organization Type (read-only) -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Organization Type</label>
              <p class="mt-1">
                <% if @organization.personal? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                    Personal Organization
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    Business Organization
                  </span>
                <% end %>
              </p>
            </div>

            <!-- Created Date (read-only) -->
            <div>
              <label class="block text-sm font-medium text-gray-700">Created</label>
              <p class="mt-1 text-sm text-gray-900"><%= @organization.created_at.strftime("%B %d, %Y") %></p>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Invoice Settings (if exists) -->
      <% if @organization.organization_setting %>
        <div class="bg-white shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200">
            <h2 class="text-lg font-medium text-gray-900">Invoice Settings</h2>
          </div>

          <div class="p-6 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700">Invoice Prefix</label>
                <p class="mt-1 text-sm text-gray-900"><%= @organization.organization_setting.invoice_prefix || 'INV' %></p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Next Invoice Number</label>
                <p class="mt-1 text-sm text-gray-900"><%= @organization.organization_setting.next_invoice_number || 1001 %></p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Default Hourly Rate</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= @organization.organization_setting.default_hourly_rate ? number_to_currency(@organization.organization_setting.default_hourly_rate) : 'Not set' %>
                </p>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700">Tax Rate</label>
                <p class="mt-1 text-sm text-gray-900">
                  <%= @organization.organization_setting.tax_rate ? "#{@organization.organization_setting.tax_rate}%" : 'Not set' %>
                </p>
              </div>
            </div>
          </div>
        </div>
      <% end %>

      <!-- Recent Activity -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-lg font-medium text-gray-900">Recent Activity</h2>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700">Active Projects</label>
              <p class="mt-1 text-2xl font-semibold text-gray-900"><%= @organization.projects.active.count %></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Total Time Entries</label>
              <p class="mt-1 text-2xl font-semibold text-gray-900"><%= @organization.time_entries.count %></p>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700">Total Invoices</label>
              <p class="mt-1 text-2xl font-semibold text-gray-900"><%= @organization.invoices.count %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Team Members -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-base font-medium text-gray-900">Team Members</h3>
        </div>
        <div class="p-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Total Members</span>
              <span class="text-sm font-medium text-gray-900"><%= @organization.member_count %></span>
            </div>

            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600">Organization Role</span>
              <span class="text-sm font-medium text-gray-900 capitalize">
                <%= current_user.role_in(@organization) %>
              </span>
            </div>

            <% if current_user.admin_of?(@organization) %>
              <div class="pt-4 border-t border-gray-200">
                <%= link_to "Manage Team Members", organization_members_path(@organization),
                    class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Subscription Status -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-base font-medium text-gray-900">Subscription</h3>
        </div>
        <div class="p-6">
          <div class="space-y-4">
            <div>
              <span class="text-sm text-gray-600">Status</span>
              <p class="mt-1">
                <% if @organization.trial? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Trial
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                    Active
                  </span>
                <% end %>
              </p>
            </div>

            <% if @organization.trial? && @organization.trial_ends_at.present? %>
              <div>
                <span class="text-sm text-gray-600">Trial Ends</span>
                <p class="mt-1 text-sm font-medium text-gray-900">
                  <%= @organization.trial_ends_at.strftime("%B %d, %Y") %>
                  <span class="text-xs text-gray-500">
                    (<%= distance_of_time_in_words_to_now(@organization.trial_ends_at) %> remaining)
                  </span>
                </p>
              </div>
            <% end %>

            <% if current_user.owner_of?(@organization) %>
              <div class="pt-4 border-t border-gray-200">
                <%= link_to "Manage Billing", settings_billing_path,
                    class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h3 class="text-base font-medium text-gray-900">Quick Actions</h3>
        </div>
        <div class="p-6 space-y-3">
          <%= link_to "View All Settings", settings_organization_path,
              class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>

          <%= link_to "View Projects", projects_path,
              class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <!-- Danger Zone -->
      <% if current_user.owner_of?(@organization) && !@organization.personal? %>
        <div class="bg-white shadow rounded-lg border border-red-200">
          <div class="px-6 py-4 border-b border-red-200 bg-red-50">
            <h3 class="text-base font-medium text-red-900">Danger Zone</h3>
          </div>
          <div class="p-6">
            <p class="text-sm text-gray-600 mb-4">
              Once you delete an organization, there is no going back. Please be certain.
            </p>
            <%= link_to "Delete Organization", organization_path(@organization),
                data: { turbo_method: :delete, turbo_confirm: "Are you sure? This will permanently delete the organization and all its data." },
                class: "w-full text-center inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
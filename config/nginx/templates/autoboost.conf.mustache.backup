# Map configuration for WebSocket
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Main log format
log_format custom '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for"';

# Frontend (Vite)
upstream frontend_server {
  server frontend:{{frontendPort}};
}

# Rails API
upstream api_server {
  server web:{{apiPort}};
}


# Main server block for HTTPS
server {
  listen 443 ssl;
  server_name {{appDomain}};

  ssl_certificate /etc/nginx/ssl/{{appDomain}}/fullchain.pem;
  ssl_certificate_key /etc/nginx/ssl/{{appDomain}}/privkey.pem;
  
  # SSL settings
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;
  ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384';
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;

  # Logging
  access_log /var/log/nginx/{{appDomain}}.access.log custom;
  error_log /var/log/nginx/{{appDomain}}.error.log;

  # Upload limits
  client_max_body_size 100M;
  client_body_timeout 60s;
  client_header_timeout 60s;
  keepalive_timeout 300s;
  send_timeout 300s;

  # Security headers
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff;
  add_header X-Frame-Options SAMEORIGIN;
  add_header X-XSS-Protection "1; mode=block";
  
  # Allow credentials in CORS for authentication
  add_header Access-Control-Allow-Credentials 'true' always;
  add_header Access-Control-Allow-Methods 'GET, POST, PUT, DELETE, OPTIONS' always;
  add_header Access-Control-Allow-Headers 'DNT,X-CustomHeader,Keep-Alive,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Authorization' always;

  # Vite HMR websocket connection
  location /@vite/client {
    proxy_pass http://frontend_server;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }

  # Handle Vite's HMR WebSocket
  location /__vite_hmr {
    proxy_pass http://frontend_server;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 86400;
  }

  # Static files for /api/images
  location ^~ /api/images/ {
    alias /rails_public/images/;
    expires 30d;
    add_header Cache-Control "public, no-transform";
  }

  # Static files for /images
  location ^~ /images/ {
    alias /frontend_public/images/;
    expires 30d;
    add_header Cache-Control "public, no-transform";
  }

  # API routes - all backend requests should be prefixed with /api
  location /api {
    proxy_pass http://api_server;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Ssl on;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    
    # Cookie handling for authentication
    proxy_set_header Cookie $http_cookie;
    proxy_pass_request_headers on;
    
    # Pass authentication cookies back to the client
    proxy_cookie_path / /;
    proxy_cookie_domain api_server $host;
    
    # WebSocket support if needed by the API
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
  }


  # Frontend routes - this is a "catch-all" location and should be the last location block
  location / {
    proxy_pass http://frontend_server;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # WebSocket support for HMR
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 86400;
  }
}

# Redirect HTTP to HTTPS
server {
  listen 80;
  server_name {{appDomain}};

  # Redirect all HTTP traffic to HTTPS
  return 301 https://$host$request_uri;
} 

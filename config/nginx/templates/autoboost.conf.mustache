# Map configuration for WebSocket
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Main log format
log_format custom '$remote_addr - $remote_user [$time_local] "$request" '
                  '$status $body_bytes_sent "$http_referer" '
                  '"$http_user_agent" "$http_x_forwarded_for"';

# DNS resolver for dynamic upstream resolution
resolver 127.0.0.11 valid=10s ipv6=off;

# Frontend (Vite) - Keep upstream for load balancing if needed
# Now using dynamic resolution instead
# upstream frontend_server {
#   server frontend:{{frontendPort}} max_fails=1 fail_timeout=10s;
#   keepalive 32;
# }

# Admin Dashboard - Keep upstream for load balancing if needed
# Commented out as admin service may not always be running
# upstream admin_server {
#   server admin:3000 max_fails=1 fail_timeout=10s;
#   keepalive 32;
# }

# Rails API - Keep upstream but with better failure handling  
# Note: This requires the web service to be running
# upstream api_server {
#   server web:{{apiPort}} max_fails=1 fail_timeout=10s;
#   keepalive 32;
# }

# Realtime service for SSE/WebSocket
# Now using dynamic resolution instead
# upstream realtime_server {
#   server realtime:3001 max_fails=1 fail_timeout=10s;
#   keepalive 32;

#!/usr/bin/env bash
set -e

# Deploy script for Kamal v2
# Loads deployment secrets from .env.deploy and runs kamal deploy

# Check if .env.deploy exists
if [ ! -f ".env.deploy" ]; then
  echo "Error: .env.deploy not found in project root"
  echo ""
  echo "Create .env.deploy with the following required variables:"
  echo ""
  echo "  # Kamal Registry"
  echo "  KAMAL_REGISTRY_USERNAME=your-github-username"
  echo "  KAMAL_REGISTRY_PASSWORD=your-github-token"
  echo ""
  echo "  # Rails"
  echo "  RAILS_MASTER_KEY=<content-of-config/credentials/production.key>"
  echo "  SECRET_KEY_BASE=<generate-with-bin/rails-secret>"
  echo ""
  echo "Note: Other secrets (DATABASE_URL, OAuth, Turnstile, AWS) come from encrypted credentials"
  echo ""
  exit 1
fi

# Load environment variables from .env.deploy
echo "Loading deployment secrets from .env.deploy..."
export $(grep -v '^#' .env.deploy | grep -v '^$' | xargs)

# Verify required Kamal variables
if [ -z "$KAMAL_REGISTRY_USERNAME" ] || [ -z "$KAMAL_REGISTRY_PASSWORD" ]; then
  echo "Error: KAMAL_REGISTRY_USERNAME and KAMAL_REGISTRY_PASSWORD must be set in .env.deploy"
  exit 1
fi

# Verify required Rails variables
if [ -z "$SECRET_KEY_BASE" ]; then
  echo "Error: SECRET_KEY_BASE must be set in .env.deploy"
  echo "Generate one with: bin/rails secret"
  exit 1
fi

if [ -z "$RAILS_MASTER_KEY" ]; then
  echo "Error: RAILS_MASTER_KEY must be set in .env.deploy"
  echo "This should be the content of config/credentials/production.key"
  exit 1
fi

echo "✓ All required secrets loaded"
echo "✓ Creating .kamal/secrets..."

# Create .kamal directory if it doesn't exist
mkdir -p .kamal

# Dynamically create .kamal/secrets from loaded environment variables
cat > .kamal/secrets <<EOF
# Dynamically generated secrets file - DO NOT COMMIT
# Generated by bin/deploy from .env.deploy

# GitHub Container Registry Authentication
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails secrets
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
SECRET_KEY_BASE=$SECRET_KEY_BASE
REDIS_URL=redis://100.64.0.48:6379/8
EOF

# Secure the secrets file
chmod 600 .kamal/secrets

echo "✓ Deploying with Kamal..."
echo ""

# Run kamal deploy with all arguments passed to this script
# Clean up secrets file after deployment (success or failure)
trap "rm -f .kamal/secrets" EXIT

kamal deploy "$@"

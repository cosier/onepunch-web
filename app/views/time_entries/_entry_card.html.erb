<div id="<%= dom_id(entry) %>"
     class="px-6 py-4 hover:bg-gray-50 transition-colors duration-150"
     data-controller="time-entry-card"
     data-time-entry-card-id-value="<%= entry.id %>">

  <div class="flex justify-between items-start">
    <!-- Entry Details -->
    <div class="flex-1">
      <div class="flex items-center space-x-2">
        <span class="inline-block w-3 h-3 rounded-full"
              style="background-color: <%= entry.project.color || '#6B7280' %>"></span>
        <%= link_to project_path(entry.project), class: "text-sm font-semibold text-gray-900 hover:text-indigo-600 transition-colors" do %>
          <%= entry.project.name %>
        <% end %>
        <% if entry.billable? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
            Billable
          </span>
        <% end %>
        <% if entry.running? %>
          <span data-running-badge
                class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-800">
            Running
          </span>
        <% end %>
      </div>

      <% if entry.description.present? %>
        <p class="text-sm text-gray-600 mt-1"><%= entry.description %></p>
      <% end %>

      <p class="text-xs text-gray-500 mt-1">
        <%= entry.started_at.strftime("%b %d, %I:%M %p") %>
        <% unless entry.running? %>
          - <%= entry.ended_at&.strftime("%I:%M %p") %>
        <% end %>
      </p>
    </div>

    <!-- Duration and Actions -->
    <div class="flex items-center space-x-4 flex-shrink-0 ml-4">
      <div class="text-right">
        <p class="text-lg font-semibold text-gray-900 font-mono">
          <%= entry.running? ? "Running..." : entry.formatted_duration %>
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-1">
        <% if entry.running? %>
          <!-- Stop Button -->
          <button data-action="click->modal#open"
                  data-modal-url="<%= stop_time_entry_path(entry) %>"
                  data-modal-method="POST"
                  data-modal-title="Stop Timer"
                  data-modal-message="Stop timer for <%= entry.project.name %>? Current duration: <%= entry.formatted_duration %>"
                  data-modal-confirm-text="Stop Timer"
                  data-modal-confirm-class="bg-orange-600 hover:bg-orange-700"
                  title="Stop timer"
                  class="p-1.5 text-orange-600 hover:text-orange-700 hover:bg-orange-50 rounded transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8 7a1 1 0 00-1 1v4a1 1 0 001 1h4a1 1 0 001-1V8a1 1 0 00-1-1H8z" clip-rule="evenodd" />
            </svg>
          </button>
        <% else %>
          <!-- Resume Button (no confirmation needed) -->
          <%= button_to resume_time_entry_path(entry),
              method: :post,
              form: { data: { turbo: true } },
              title: "Resume timer",
              class: "p-1.5 text-green-600 hover:text-green-700 hover:bg-green-50 rounded transition-colors" do %>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
            </svg>
          <% end %>
        <% end %>

        <!-- Edit Button -->
        <%= link_to edit_time_entry_path(entry),
            title: "Edit entry",
            class: "p-1.5 text-gray-600 hover:text-gray-700 hover:bg-gray-50 rounded transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        <% end %>

        <!-- Delete Button -->
        <button data-action="click->modal#open"
                data-modal-url="<%= time_entry_path(entry) %>"
                data-modal-method="DELETE"
                data-modal-title="Delete Time Entry"
                data-modal-message="Delete time entry for <%= entry.project.name %>? This action cannot be undone."
                data-modal-confirm-text="Delete"
                data-modal-confirm-class="bg-red-600 hover:bg-red-700"
                title="Delete entry"
                class="p-1.5 text-red-600 hover:text-red-700 hover:bg-red-50 rounded transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="max-w-md mx-auto">
    <div class="bg-white shadow rounded-lg p-6">
      <!-- Success Icon -->
      <div class="text-center mb-6">
        <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-green-100 mb-4">
          <svg
            class="h-6 w-6 text-green-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"
            ></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-gray-900 mb-2">Authorization Successful</h1>
        <p class="text-gray-600">
          You've authorized <strong><%= @application_name %></strong>
        </p>
      </div>
      <!-- Authorization Code -->
      <div class="mb-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">
          Authorization Code
        </label>
        <div class="relative">
          <input
            type="text"
            id="auth-code"
            readonly
            value="<%= @authorization_code %>"
            class="
              w-full px-3 py-2 border border-gray-300 rounded-lg bg-gray-50
              font-mono text-sm text-gray-900 focus:outline-none focus:ring-2 focus:ring-indigo-500
            "
          />
          <button
            type="button"
            id="copy-button"
            class="
              absolute right-2 top-1/2 transform -translate-y-1/2
              px-3 py-1 text-sm font-medium text-indigo-600 hover:text-indigo-700
              hover:bg-indigo-50 rounded
            "
          >
            Copy
          </button>
        </div>
        <p class="mt-2 text-sm text-gray-500">
          <% if @redirect_uri.present? %>
            Copy this code and paste it into the desktop application
          <% else %>
            Copy this code and paste it into the CLI terminal
          <% end %>
        </p>
      </div>
      <% if @redirect_uri.present? %>
        <!-- Auto-redirect Status -->
        <div id="auto-redirect-section" class="mb-6 text-center">
        <div class="inline-flex items-center space-x-2 text-gray-600">
          <svg
            class="animate-spin h-5 w-5 text-indigo-600"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
          <span>Opening desktop app in <span id="countdown">3</span> seconds...</span>
        </div>
      </div>
      <% end %>
      <!-- Manual Actions -->
      <div class="space-y-3">
        <% if @redirect_uri.present? %>
          <button
            type="button"
            id="open-app-button"
            class="
              w-full bg-indigo-600 text-white py-2 px-4 rounded-lg
              hover:bg-indigo-700 font-medium
            "
          >
            Open Desktop App Manually
          </button>
        <% end %>
        <button
          type="button"
          onclick="window.close()"
          class="
            w-full bg-white text-gray-700 py-2 px-4 rounded-lg
            border border-gray-300 hover:bg-gray-50 font-medium
          "
        >
          Close Window
        </button>
      </div>
      <!-- Instructions -->
      <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h3 class="text-sm font-medium text-blue-900 mb-2">What to do next:</h3>
        <% if @redirect_uri.present? %>
          <ol class="text-sm text-blue-800 space-y-1 list-decimal list-inside">
            <li>The desktop app should open automatically</li>
            <li>If it doesn't, click "Open Desktop App Manually"</li>
            <li>Or copy the code above and paste it in the app</li>
          </ol>
        <% else %>
          <ol class="text-sm text-blue-800 space-y-1 list-decimal list-inside">
            <li>Copy the authorization code above</li>
            <li>Return to your terminal</li>
            <li>Paste the code when prompted</li>
          </ol>
        <% end %>
      </div>
    </div>
  </div>
</div>
<script>
  // Copy to clipboard functionality
  const copyButton = document.getElementById('copy-button');
  const authCodeInput = document.getElementById('auth-code');

  copyButton.addEventListener('click', () => {
    authCodeInput.select();
    document.execCommand('copy');

    // Show feedback
    const originalText = copyButton.textContent;
    copyButton.textContent = 'Copied!';
    copyButton.classList.add('text-green-600');

    setTimeout(() => {
      copyButton.textContent = originalText;
      copyButton.classList.remove('text-green-600');
    }, 2000);
  });

  // Auto-redirect with countdown (only for desktop app flow)
  const redirectUri = "<%= j @redirect_uri %>";

  if (redirectUri) {
    let countdown = 3;
    const countdownElement = document.getElementById('countdown');

    const countdownInterval = setInterval(() => {
      countdown--;
      if (countdownElement) {
        countdownElement.textContent = countdown;
      }

      if (countdown <= 0) {
        clearInterval(countdownInterval);
        window.location.href = redirectUri;
      }
    }, 1000);

    // Manual open app button
    const openAppButton = document.getElementById('open-app-button');
    if (openAppButton) {
      openAppButton.addEventListener('click', () => {
        window.location.href = redirectUri;
      });
    }

    // Clean up interval when page is hidden (user navigated away)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearInterval(countdownInterval);
      }
    });
  }
</script>

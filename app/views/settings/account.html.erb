<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Account Settings</h1>
    <p class="text-gray-600 mt-1">Manage your personal account information</p>
  </div>

  <%= render 'shared/password_alert_banner' %>

  <!-- Avatar Section -->
  <div class="bg-white shadow rounded-lg mb-6" data-controller="avatar-modal">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Profile Picture</h2>
    </div>

    <div class="p-6">
      <div class="flex items-center justify-between">
        <%= render 'settings/avatars/preview', user: current_user %>

        <button type="button"
                data-action="click->avatar-modal#open"
                class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
          Edit Avatar
        </button>
      </div>
    </div>

    <!-- Avatar Edit Modal -->
    <%= render 'settings/avatars/edit_modal' %>
  </div>

  <div class="bg-white shadow rounded-lg">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Account Information</h2>
    </div>

    <div class="p-6 space-y-6">
      <!-- Email -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
        <div class="flex items-center justify-between">
          <p class="text-gray-900"><%= current_user.email %></p>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Primary
          </span>
        </div>
      </div>

      <!-- Account Created -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Account Created</label>
        <p class="text-gray-900"><%= current_user.created_at.strftime("%B %d, %Y") %></p>
      </div>

      <!-- Last Sign In -->
      <% if current_user.last_sign_in_at? %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Last Sign In</label>
          <p class="text-gray-900"><%= time_ago_in_words(current_user.last_sign_in_at) %> ago</p>
        </div>
      <% end %>

      <!-- Organizations -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Your Organizations</label>
        <div class="space-y-2">
          <% current_user.organizations.each do |org| %>
            <div class="flex items-center justify-between p-3 border border-gray-200 rounded-lg <%= org == current_organization ? 'bg-indigo-50 border-indigo-300' : '' %>">
              <div class="flex items-center space-x-3">
                <% if org.personal? %>
                  <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                <% else %>
                  <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                <% end %>
                <div>
                  <p class="font-medium text-gray-900">
                    <%= org.personal? ? "Personal Organization" : org.name %>
                  </p>
                  <% if org == current_organization %>
                    <span class="text-xs text-indigo-600">Currently active</span>
                  <% end %>
                </div>
              </div>
              <% unless org == current_organization %>
                <%= link_to "Switch", switch_organization_path(org), method: :patch,
                    class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- API Tokens Section -->
  <div class="bg-white shadow rounded-lg mt-6" data-controller="api-token-modal">
    <div class="px-6 py-4 border-b border-gray-200">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">API Tokens</h2>
          <p class="text-sm text-gray-500 mt-1">Manage API tokens for authenticating with the OnePunch API</p>
        </div>
        <button type="button"
                data-action="click->api-token-modal#openNew"
                data-turbo-frame="api_token_modal"
                class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Generate New Token
        </button>
      </div>
    </div>

    <div class="p-6">
      <div id="flash_messages"></div>

      <div id="api_tokens_list" class="space-y-3">
        <% if current_user.active_api_tokens.any? %>
          <%= render current_user.active_api_tokens %>
        <% else %>
          <div class="text-center py-8">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No API tokens</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by creating a new API token.</p>
            <div class="mt-6">
              <button type="button"
                      data-action="click->api-token-modal#openNew"
                      class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                <svg class="h-4 w-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Generate New Token
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- API Token Modal -->
    <%= render "settings/api_tokens/modal" %>
  </div>

  <!-- Password Section -->
  <div class="bg-white shadow rounded-lg mt-6">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-lg font-semibold text-gray-900">Security</h2>
    </div>

    <div class="p-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-medium text-gray-900">Password</h3>
          <% if current_user.oauth_only_user? %>
            <p class="text-sm text-amber-600">No password set - you login with Google</p>
          <% else %>
            <p class="text-sm text-gray-500">Change your password to keep your account secure</p>
          <% end %>
        </div>
        <% if current_user.oauth_only_user? %>
          <%= link_to settings_password_setup_path,
              class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
            Set Password
          <% end %>
        <% else %>
          <button type="button" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Change Password
          </button>
        <% end %>
      </div>

      <% if current_user.google_uid.present? %>
        <div class="mt-4 pt-4 border-t border-gray-200">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-medium text-gray-900">Google Sign-In</h3>
              <p class="text-sm text-gray-500">Connected to <%= current_user.email %></p>
            </div>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              Connected
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Danger Zone -->
  <div class="bg-red-50 border border-red-200 rounded-lg mt-6">
    <div class="px-6 py-4 border-b border-red-200">
      <h2 class="text-lg font-semibold text-red-900">Danger Zone</h2>
    </div>

    <div class="p-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-medium text-red-900">Delete Account</h3>
          <p class="text-sm text-red-700">Permanently delete your account and all associated data</p>
        </div>
        <button type="button" class="inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
          Delete Account
        </button>
      </div>
    </div>
  </div>
</div>
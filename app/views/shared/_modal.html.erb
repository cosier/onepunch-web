<!-- Confirmation Modal -->
<div id="confirmation-modal"
     data-modal-target="container"
     class="hidden fixed z-50 inset-0 overflow-y-auto"
     aria-labelledby="modal-title"
     role="dialog"
     aria-modal="true">

  <!-- Background backdrop -->
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">

    <!-- Backdrop overlay -->
    <div data-modal-target="backdrop"
         data-action="click->modal#handleBackdropClick"
         class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity opacity-0"
         aria-hidden="true"></div>

    <!-- This element is to trick the browser into centering the modal contents. -->
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>

    <!-- Modal panel -->
    <div data-modal-target="panel"
         class="relative inline-block align-bottom bg-white rounded-lg px-4 pt-5 pb-4 text-left overflow-hidden shadow-xl transform transition-all opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95 sm:my-8 sm:align-middle sm:max-w-lg sm:w-full sm:p-6">

      <div class="sm:flex sm:items-start">
        <!-- Icon -->
        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
          <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>

        <!-- Content -->
        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left">
          <h3 data-modal-target="title"
              class="text-lg leading-6 font-medium text-gray-900"
              id="modal-title">
            Confirm Action
          </h3>
          <div class="mt-2">
            <p data-modal-target="message"
               class="text-sm text-gray-500">
              Are you sure you want to perform this action?
            </p>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="mt-5 sm:mt-4 sm:flex sm:flex-row-reverse">
        <button data-modal-target="confirmBtn"
                data-action="click->modal#confirm"
                type="button"
                class="inline-flex justify-center w-full rounded-md border border-transparent px-4 py-2 text-base font-medium text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-offset-2 sm:ml-3 sm:w-auto sm:text-sm bg-red-600 hover:bg-red-700 focus:ring-red-500">
          Confirm
        </button>
        <button data-modal-target="cancelBtn"
                data-action="click->modal#cancel"
                type="button"
                class="mt-3 inline-flex justify-center w-full rounded-md border border-gray-300 px-4 py-2 bg-white text-base font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:w-auto sm:text-sm">
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>
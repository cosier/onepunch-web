<!DOCTYPE html>
<html>
  <head>
    <title>Admin - OnePunch</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50">
    <!-- Admin Header -->
    <nav class="bg-red-600 border-b border-red-700">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <div class="flex-shrink-0 flex items-center">
              <%= link_to admin_root_path, class: "text-white text-xl font-bold" do %>
                ⚡ OnePunch Admin
              <% end %>
            </div>
            <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
              <%= link_to "Dashboard", admin_root_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-white hover:text-red-100" %>
              <%= link_to "Users", admin_users_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-white hover:text-red-100" %>
              <%= link_to "Organizations", admin_organizations_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-white hover:text-red-100" %>
            </div>
          </div>
          <div class="flex items-center">
            <%= link_to "← Back to App", root_path, class: "text-white hover:text-red-100 text-sm font-medium" %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Admin content -->
    <main class="py-10">
      <% if notice %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
          <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded">
            <%= notice %>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-4">
          <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded">
            <%= alert %>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>